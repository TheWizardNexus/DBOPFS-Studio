{
  "name": "dbopfs-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A DBOPFS-powered Chromium workspace for exploring and managing origin-private file systems.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/render-icons.mjs",
    "promo:video": "node scripts/render-promo-video.mjs",
    "store:assets": "node scripts/render-store-assets.mjs",
    "store:assets:check": "node scripts/validate-store-assets.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/test-all.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "coverage": "node scripts/test-browser.mjs --coverage --threshold 60",
    "validate": "node scripts/validate-release.mjs",
    "package": "node scripts/package-extension.mjs",
    "release:test": "node scripts/release-test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheWizardNexus/DBOPFS-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/TheWizardNexus/DBOPFS-Studio/issues"
  },
  "homepage": "https://thewizardnexus.github.io/DBOPFS-Studio/",
  "author": "The Wizard Nexus",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "fflate": "0.8.2",
    "puppeteer-core": "25.7.0",
    "vanilla-test": "2.1.0"
  }
}
